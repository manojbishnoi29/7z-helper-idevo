package com.sevenzrecovery.helper

import android.content.ContentResolver
import android.net.Uri
import com.facebook.react.bridge.Promise
import com.facebook.react.bridge.ReactApplicationContext
import com.facebook.react.bridge.ReactContextBaseJavaModule
import com.facebook.react.bridge.ReactMethod
import net.sf.sevenzipjbinding.IInArchive
import net.sf.sevenzipjbinding.SevenZip
import net.sf.sevenzipjbinding.impl.RandomAccessFileInStream
import net.sf.sevenzipjbinding.simple.ISimpleInArchive
import net.sf.sevenzipjbinding.simple.ISimpleInArchiveItem
import java.io.File
import java.io.RandomAccessFile

class SevenZipModule(reactContext: ReactApplicationContext) : ReactContextBaseJavaModule(reactContext) {

    override fun getName() = "SevenZipModule"

    @ReactMethod
    fun verifyPassword(archiveUri: String, password: String, promise: Promise) {
        try {
            val uri = Uri.parse(archiveUri)
            val resolver: ContentResolver = reactApplicationContext.contentResolver
            val pfd = resolver.openFileDescriptor(uri, "r")
                ?: return promise.resolve("error:Unable to open archive file descriptor")

            // Copy to temp file because SevenZipJBinding needs RandomAccess
            val tempFile = File.createTempFile("7z_verify", ".7z", reactApplicationContext.cacheDir)
            pfd.use { fd ->
                File(tempFile.absolutePath).outputStream().use { out ->
                    File("/proc/self/fd/${fd.fd}").inputStream().use { inp -> inp.copyTo(out) }
                }
            }

            // Alternative: use ParcelFileDescriptor.AutoCloseInputStream
            // For brevity, we use tempFile approach above which is SAF-safe.

            var result = "incorrect"
            var archive: IInArchive? = null
            try {
                val raf = RandomAccessFile(tempFile, "r")
                archive = SevenZip.openInArchive(null, RandomAccessFileInStream(raf))
                val simple: ISimpleInArchive = archive.simpleInterface
                // If encrypted, we must provide password to extract; without password, getItem will throw or return null
                // Attempt to get items and test extraction of first item
                val items: Array<ISimpleInArchiveItem> = simple.archiveItems
                if (items.isEmpty()) {
                    // Empty archive — consider password correct if it opens
                    result = "correct"
                } else {
                    var foundEncrypted = false
                    for (item in items) {
                        // Try to extract first non-directory item with password
                        if (!item.isFolder) {
                            foundEncrypted = true
                            try {
                                val out = java.io.ByteArrayOutputStream()
                                val extractResult = item.extractSlow { data -> out.write(data); data.size } as? net.sf.sevenzipjbinding.ISequentialOutStream
                                // SevenZipJBinding simple API: use ExtractOperationResult
                                // Instead, use callback-based extraction:
                                val res = item.extractSlow { bytes ->
                                    out.write(bytes)
                                    bytes.size
                                }
                                // If we get here without exception, check result
                                result = "correct"
                            } catch (e: Exception) {
                                val msg = e.message ?: ""
                                when {
                                    msg.contains("Wrong password", ignoreCase = true) ||
                                    msg.contains("Password", ignoreCase = true) -> result = "incorrect"
                                    msg.contains("Unsupported", ignoreCase = true) -> result = "unsupported"
                                    else -> result = "error:${e.message}"
                                }
                            }
                            break
                        }
                    }
                    if (!foundEncrypted) result = "correct"
                }
            } catch (e: Exception) {
                val msg = e.message ?: ""
                result = when {
                    msg.contains("not a 7z", ignoreCase = true) -> "unsupported"
                    msg.contains("Headers Error", ignoreCase = true) -> "corrupted"
                    msg.contains("Password", ignoreCase = true) -> "incorrect"
                    else -> "error:${e.message}"
                }
            } finally {
                try { archive?.close() } catch (_: Exception) {}
                tempFile.delete()
            }

            // Zero password chars best-effort (not strictly necessary for Promise string)
            promise.resolve(result)
        } catch (e: Exception) {
            promise.resolve("error:${e.message}")
        }
    }

    @ReactMethod
    fun extractArchive(archiveUri: String, password: String, outputUri: String, promise: Promise) {
        // Implement extraction to SAF tree URI:
        // 1. Open archive as above
        // 2. Resolve outputUri via DocumentFile.fromTreeUri
        // 3. For each item, create file via DocumentFile.createFile and stream extractSlow with password
        // 4. Skip if file exists (no overwrite)
        // 5. Return { success, filesExtracted, error }
        // Full implementation omitted for brevity — see native/README.md
        promise.resolve(mapOf("success" to false, "filesExtracted" to 0, "error" to "Not yet implemented in example — see README"))
    }
}
